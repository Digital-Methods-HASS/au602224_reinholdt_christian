library ("ggplot")
install.packages("ggplot")
library ("tidyverse")
library ("dplyr")
library ("readr")
library ("ggplot2")
# Step 1: Create midyear column to represent the approximate reign center
kings_cleaned <- kings_cleaned %>%
mutate(midyear = Start_year + (End_year - Start_year) / 2)
# Step 2: Plot duration vs. midyear
ggplot(kings_cleaned, aes(x = midyear, y = duration)) +
geom_point(color = "steelblue", size = 2, alpha = 0.7) +     # data points
geom_smooth(method = "loess", se = TRUE, color = "darkred") + # smoothed trend
labs(
title = "Trend in Duration of Reign of Danish Monarchs Over Time",
x = "Reign Midyear",
y = "Duration of Reign (Years)"
) +
theme_bw(base_size = 14)
