kings <- read_csv("data/kings data.csv")
class(kings)
glimpse(kings)
kings <- kings %>%
mutate(
Name = as.character(Name),
House = as.character(House),
Start_year = as.numeric(Start_year),
End_year = as.numeric(End_year),
Birth_year = as.numeric(Birth_year),
Death_year = as.numeric(Death_year),
Gender = as.character(Gender),
Dynasty = as.character(Dynasty),
Source = as.character(Source),
BirthDMY = as.character(BirthDMY),
DeathDMY = as.character(DeathDMY)
) %>%
filter(
!is.na(Start_year),
!is.na(End_year)
)
kings_cleaned <- kings %>%
mutate(duration = End_year - Start_year)
library(dplyr)
mean_duration <- kings_cleaned %>%
summarize(avg_duration = mean(duration, na.rm = TRUE))
mean_duration
long_reign_kings <- kings_cleaned %>%
filter(duration > mean_duration)
print(long_reign_kings)
long_reign_kings %>%
count()
kings_cleaned %>%
arrange(desc(duration)) %>%
slice(1:3) %>%
mutate(
Days = duration * 365.25,
Days = Days
) %>%
select(Name, duration, Days)
kings_cleaned <- kings_cleaned %>%
mutate(midyear = Start_year + (End_year - Start_year) / 2)
ggplot(kings_cleaned, aes(x = midyear, y = duration)) +
geom_point(color = "steelblue", size = 2, alpha = 0.7) +
geom_smooth(method = "loess", se = TRUE, color = "darkred") +
labs(
title = "Trend in Duration of Reign of Danish Monarchs Over Time",
x = "Reign Midyear",
y = "Duration of Reign (Years)"
) +
theme_bw(base_size = 14)
