lotr_p19 <- lotr_text[19]
knitr::opts_chunk$set(echo = TRUE,
warning = FALSE,
message = FALSE)
library(tidyverse)
library(here)
# For text mining:
library(pdftools)
library(tidytext)
library(textdata)
library(ggwordcloud)
lotr_path <- here("data/lotr.pdf")
lotr_text <- pdf_text(lotr_path)
lotr_p19 <- lotr_text[19]
lotr_p19
lotr_p59 <- lotr_text[59]
lotr_p59
lotr_df <- data.frame(lotr_text) %>%
mutate(text_full = str_split(lotr_text, pattern = '\n')) %>%
unnest(text_full) %>%
mutate(text_full = str_trim(text_full))
# More information: https://cran.r-project.org/web/packages/stringr/vignettes/regular-expressions.html
View(lotr_df)
lotr_tokens <- lotr_df %>%
unnest_tokens(word, text_full)
# See how this differs from `ipcc_df`
# Each word has its own row!
View(lotr_tokens)
lotr_wc <- lotr_tokens %>%
count(word) %>%
arrange(-n)
lotr_wc
lotr_stop <- lotr_tokens %>%
anti_join(stop_words) %>%
select(-lotr_text)
lotr_swc <- lotr_stop %>%
count(word) %>%
arrange(-n)
View(lotr_swc)
# This code will filter out numbers by asking:
# If you convert to as.numeric, is it NA (meaning those words)?
# If it IS NA (is.na), then keep it (so all words are kept)
# Anything that is converted to a number is removed
lotr_no_numeric <- lotr_stop %>%
filter(is.na(as.numeric(word)))
View(lotr_no_numeric)
# There are almost 2000 unique words
length(unique(lotr_no_numeric$word))
# We probably don't want to include them all in a word cloud. Let's filter to only include the top 100 most frequent?
lotr_top100 <- lotr_no_numeric %>%
count(word) %>%
arrange(-n) %>%
head(100)
lotr_top100
lotr_cloud <- ggplot(data = lotr_top100, aes(label = word)) +
geom_text_wordcloud() +
theme_minimal()
lotr_cloud
ggplot(data = lotr_top100, aes(label = word, size = n)) +
geom_text_wordcloud_area(aes(color = n), shape = "star") +
scale_size_area(max_size = 12) +
scale_color_gradientn(colors = c("darkgreen","blue","red")) +
theme_minimal()
get_sentiments(lexicon = "afinn")
# You should be prompted to install lexicon - choose yes!
# Let's look at the pretty positive words:
afinn_pos <- get_sentiments("afinn") %>%
filter(value %in% c(3,4,5))
# Do not look at negative words in class.
afinn_pos
get_sentiments(lexicon = "bing")
# You should be prompted to install lexicon - choose yes!
get_sentiments(lexicon = "nrc")
1
get_sentiments(lexicon = "nrc")
lotr_afinn <- lotr_stop %>%
inner_join(get_sentiments("afinn"))
lotr_afinn
lotr_afinn_hist <- lotr_afinn %>%
count(value)
# Plot them:
ggplot(data = lotr_afinn_hist, aes(x = value, y = n)) +
geom_col(aes(fill = value)) +
theme_bw()
# What are these '2' words?
lotr_afinn2 <- lotr_afinn %>%
filter(value == 2)
View(lotr_afinn2)
# Check the unique 2-score words:
unique(lotr_afinn2$word)
# Count & plot them
lotr_afinn2_n <- lotr_afinn2 %>%
count(word, sort = TRUE) %>%
mutate(word = fct_reorder(factor(word), n))
ggplot(data = lotr_afinn2_n, aes(x = word, y = n)) +
geom_col() +
coord_flip() +
theme_bw()
# OK so what's the deal with confidence? And is it really "positive" in the emotion sense?
lotr_summary <- lotr_afinn %>%
summarize(
mean_score = mean(value),
median_score = median(value)
)
lotr_summary
lotr_nrc <- lotr_stop %>%
inner_join(get_sentiments("nrc"))
knitr::opts_chunk$set(echo = TRUE,
warning = FALSE,
message = FALSE)
library(tidyverse)
library(here)
# For text mining:
library(pdftools)
library(tidytext)
library(textdata)
library(ggwordcloud)
lotr_path <- here("data/lotr.pdf")
lotr_text <- pdf_text(lotr_path)
lotr_p59 <- lotr_text[59]
lotr_p59
lotr_df <- data.frame(lotr_text) %>%
mutate(text_full = str_split(lotr_text, pattern = '\n')) %>%
unnest(text_full) %>%
mutate(text_full = str_trim(text_full))
# More information: https://cran.r-project.org/web/packages/stringr/vignettes/regular-expressions.html
lotr_tokens <- lotr_df %>%
unnest_tokens(word, text_full)
# See how this differs from `ipcc_df`
# Each word has its own row!
lotr_wc <- lotr_tokens %>%
count(word) %>%
arrange(-n)
lotr_wc
lotr_stop <- lotr_tokens %>%
anti_join(stop_words) %>%
select(-lotr_text)
lotr_swc <- lotr_stop %>%
count(word) %>%
arrange(-n)
# This code will filter out numbers by asking:
# If you convert to as.numeric, is it NA (meaning those words)?
# If it IS NA (is.na), then keep it (so all words are kept)
# Anything that is converted to a number is removed
lotr_no_numeric <- lotr_stop %>%
filter(is.na(as.numeric(word)))
# There are almost 2000 unique words in the IPCC - well, there are 14,856 in LOTR.
length(unique(lotr_no_numeric$word))
# We probably don't want to include them all in a word cloud. Let's filter to only include the top 100 most frequent?
lotr_top100 <- lotr_no_numeric %>%
count(word) %>%
arrange(-n) %>%
head(100)
lotr_top100
lotr_cloud <- ggplot(data = lotr_top100, aes(label = word)) +
geom_text_wordcloud() +
theme_minimal()
lotr_cloud
ggplot(data = lotr_top100, aes(label = word, size = n)) +
geom_text_wordcloud_area(aes(color = n), shape = "star") +
scale_size_area(max_size = 12) +
scale_color_gradientn(colors = c("darkgreen","blue","red")) +
theme_minimal()
get_sentiments(lexicon = "afinn")
# You should be prompted to install lexicon - choose yes!
# Let's look at the pretty positive words:
afinn_pos <- get_sentiments("afinn") %>%
filter(value %in% c(3,4,5))
# Do not look at negative words in class.
afinn_pos
get_sentiments(lexicon = "bing")
# You should be prompted to install lexicon - choose yes!
get_sentiments(lexicon = "nrc")
# You should be prompted to install lexicon - choose yes!
lotr_afinn <- lotr_stop %>%
inner_join(get_sentiments("afinn"))
lotr_afinn
lotr_afinn_hist <- lotr_afinn %>%
count(value)
# Plot them:
ggplot(data = lotr_afinn_hist, aes(x = value, y = n)) +
geom_col(aes(fill = value)) +
theme_bw() +
labs(
title = "Distribution of AFINN Sentiment Scores in LOTR",
x = "AFINN Sentiment Score",
y = "Number of Words"
)
# What are these '2' words?
lotr_afinn2 <- lotr_afinn %>%
filter(value == 2)
# Check the unique 2-score words:
unique(lotr_afinn2$word)
# Count & plot them
lotr_afinn2_n <- lotr_afinn2 %>%
count(word, sort = TRUE) %>%
mutate(word = fct_reorder(factor(word), n))
ggplot(data = lotr_afinn2_n, aes(x = word, y = n)) +
geom_col() +
coord_flip() +
theme_bw()
lotr_summary <- lotr_afinn %>%
summarize(
mean_score = mean(value),
median_score = median(value)
)
lotr_summary
